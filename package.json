{
    "name": "comfaca-credito-frontend",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.26.2",
    "scripts": {
        "dev": "nuxt dev",
        "build": "nuxt build",
        "preview": "nuxt preview",
        "cap:init": "cap init",
        "cap:add:android": "cap add android",
        "cap:add:ios": "cap add ios",
        "cap:build": "npm run build && cap sync",
        "cap:run:android": "cap run android",
        "cap:run:ios": "cap run ios",
        "cap:sync": "npx cap sync",
        "cap:open:android": "npx cap open android",
        "dev:android": "pnpm dev & npx cap sync android && npx cap run android --target ZY32DD9HMT",
        "cap:android:usb": "pnpm dev & npx cap run android --target ZY32DD9HMT",
        "cap:android:emulator": "pnpm dev & npx cap sync android && npx cap run android --target ZY32DD9HMT",
        "dev:tools": "node ./dev-tools.js"
    },
    "dependencies": {
        "@capacitor/camera": "^8.0.0",
        "@capacitor/filesystem": "^8.0.0",
        "@capgo/capacitor-data-storage-sqlite": "^8.0.4",
        "@heroicons/vue": "^2.2.0",
        "nuxt": "^4.2.2",
        "qrcode": "^1.5.4",
        "vue": "^3.5.25",
        "vue-router": "^4.6.4",
        "@capacitor/share": "^6.0.0",
        "@ionic/pwa-elements": "^3.3.0"
    },
    "devDependencies": {
        "@capacitor/android": "^8.0.0",
        "@capacitor/cli": "^8.0.0",
        "@capacitor/core": "^8.0.0",
        "@capacitor/ios": "^8.0.0",
        "@tailwindcss/postcss": "^4.0.0",
        "@types/node": "^22.10.2",
        "autoprefixer": "^10.4.21",
        "daisyui": "^5.5.14",
        "postcss": "^8.5.3",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.8.2"
    }
}